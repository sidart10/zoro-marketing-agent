{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Agent private workspace header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "display_name": {
      "type": "string"
    }
  }
}
